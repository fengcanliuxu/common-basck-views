{
    "//": "是否使用分号",
    "semi": true,
    "//": "每行字符长度",
    "printWidth": 80,
    "//": "是否使用单引号",
    "singleQuote": false,
    "//": "tab宽度",
    "tabWidth": 4,
    "//": "是否在对象文字中使用引号",
    "quoteProps": "as-needed",
    "//": "尽可能尾随逗号",
    "trailingComma": "all",
    "//": "是否在括号中使用空格",
    "bracketSpacing": true,
    "//": "对象包裹",
    "objectWrap": "preserve",
    "//": "是否将括号放在同一行 --- ** 重要",
    "bracketSameLine": true,
    "//": "是否在箭头函数中使用括号",
    "arrowParens": "always",
    "//": "是否缩进Vue脚本和样式",
    "vueIndentScriptAndStyle": true,
    "//": "结合ts",
    "experimentalStripTypes": true
}